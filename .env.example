# Public, non-sensitive Compose variables.
# COMPOSE_PROJECT_NAME: Docker Compose project namespace. Required. No default.
COMPOSE_PROJECT_NAME=change-me
# API_PORT: Host port exposed for the backend API. Required. No default.
API_PORT=8000
# MINIO_API_PORT: Host port exposed for the MinIO API. Required. No default.
MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT: Host port exposed for the MinIO console. Required. No default.
MINIO_CONSOLE_PORT=9001
# TZ: Container timezone. Required. Default: UTC.
TZ=UTC
