# Release identity
APP_ENV=local
APP_VERSION=0.1.0-p00
OPENAPI_REVISION=v2-p00
GIT_REVISION=development
BUILD_TIME=development

# Container build bases (override with the official image names when Docker Hub is reachable)
PYTHON_BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.14-slim
NODE_BASE_IMAGE=public.ecr.aws/docker/library/node:24-alpine
NGINX_BASE_IMAGE=m.daocloud.io/docker.io/library/nginx:1.29-alpine
DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security

# Django
DJANGO_SETTINGS_MODULE=education_experiment_platform.settings.local
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django,user.localhost,teacher.localhost,admin.localhost,api.localhost
DJANGO_TRUSTED_ORIGINS=http://user.localhost:8080,http://teacher.localhost:8080,http://admin.localhost:8080
TRUSTED_PROXY_CIDRS=127.0.0.0/8,172.29.20.0/24

# MySQL
MYSQL_IMAGE=public.ecr.aws/docker/library/mysql:8.4
MYSQL_DATABASE=edu_platform
MYSQL_USER=edu_platform
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-root-password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MongoDB runtime logs only
MONGO_INITDB_ROOT_USERNAME=runtime_logger
MONGO_INITDB_ROOT_PASSWORD=replace-mongo-password
MONGO_REPLICA_SET_KEY=replace-with-a-random-string-longer-than-32-characters
MONGODB_URI=mongodb://runtime_logger:replace-mongo-password@mongodb:27017/observability?authSource=admin&replicaSet=rs0
MONGODB_LOG_DATABASE=observability
MONGODB_LOG_COLLECTION=runtime_logs
MONGODB_LOG_TTL_DAYS=30

# MinIO / ClamAV
MINIO_ROOT_USER=edu-platform
MINIO_ROOT_PASSWORD=replace-minio-password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=edu-platform
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Gateway
KONG_LOG_LEVEL=notice

# Observability
OTEL_SERVICE_NAME=edu-platform-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
LOG_LEVEL=INFO
