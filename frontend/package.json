{
  "name": "edu-platform-frontend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@11.6.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:user": "npm run dev -w @edu/user-web",
    "dev:teacher": "npm run dev -w @edu/teacher-web",
    "dev:admin": "npm run dev -w @edu/admin-web",
    "build": "npm run build:user && npm run build:teacher && npm run build:admin",
    "build:user": "npm run build -w @edu/user-web",
    "build:teacher": "npm run build -w @edu/teacher-web",
    "build:admin": "npm run build -w @edu/admin-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages e2e --max-warnings=0",
    "test": "vitest run",
    "test:e2e:user": "playwright test --project=user-web",
    "test:e2e:teacher": "playwright test --project=teacher-web",
    "test:e2e:admin": "playwright test --project=admin-web",
    "generate:api": "openapi-typescript openapi.json -o packages/api-client/src/generated/schema.d.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.5.2",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.0.3",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.21",
    "globals": "16.4.0",
    "jsdom": "27.0.0",
    "openapi-typescript": "7.9.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
