# ──────────────────────────────────────────────────────────
# EduTech 生产环境后端配置
# 复制此文件为 .env.prod 并填写真实值
# cp .env.prod.example .env.prod
# ──────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────
# 生成: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# 逗号分隔的域名/IP，如: 47.114.40.7,edutech.example.com
DJANGO_ALLOWED_HOSTS=47.114.40.7

# ── MySQL（服务器已有实例）────────────────────────────────
# 通过 edutech-infra 网络连接时，使用容器名或 IP
# 通过 host 连接时，使用 host.docker.internal
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_NAME=edutech
MYSQL_USER=edutech
MYSQL_PASSWORD=
# 生产环境不需要 root 密码（已有实例）
MYSQL_ROOT_PASSWORD=unused

# ── Redis（服务器已有实例）────────────────────────────────
REDIS_CACHE_URL=redis://host.docker.internal:6379/0
CELERY_BROKER_URL=redis://host.docker.internal:6379/1

# ── MinIO（由 docker-compose.prod.yml 管理）───────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_GENERAL_BUCKET=edutech-general
MINIO_ARCHIVE_BUCKET=edutech-archive
MINIO_SNAPSHOT_BUCKET=edutech-snapshot
MINIO_EXPORT_BUCKET=edutech-export

# ── 部署参数 ──────────────────────────────────────────────
BACKEND_IMAGE=edutech/backend:latest
API_REPLICAS=2
TZ=Asia/Shanghai
