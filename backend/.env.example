APP_ENV=local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

MYSQL_DATABASE=your_database_name
MYSQL_USER=your_database_user
MYSQL_PASSWORD=replace-with-your-local-password
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
SECRET_KEY=replace-with-a-required-secret
DJANGO_SETTINGS_MODULE=education_experiment_platform.settings.local
ALLOWED_HOSTS=localhost,127.0.0.1
REDIS_URL=redis://localhost:6379/0
MONGODB_URI=mongodb://localhost:27017/education_experiment_platform
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace-with-access-key
MINIO_SECRET_KEY=replace-with-secret-key
MINIO_USE_SSL=false
MINIO_BUCKET=education-experiment-platform
PORTAL_TRUSTED_PROXY_NETWORKS=127.0.0.0/8
PORTAL_USER_HOSTS=user.localhost
PORTAL_TEACHING_HOSTS=teaching.localhost
PORTAL_PLATFORM_HOSTS=platform.localhost
