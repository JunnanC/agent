# Backend runtime configuration.
# DJANGO_SECRET_KEY: Django secret key. Required. No default.
DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG: Enable Django debug mode. Optional. Default: false.
DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS: Comma-separated production hosts. Required in prod.
DJANGO_ALLOWED_HOSTS=change-me
# MYSQL_HOST: MySQL hostname. Required. No default.
MYSQL_HOST=mysql
# MYSQL_PORT: MySQL port. Required. No default.
MYSQL_PORT=3306
# MYSQL_NAME: MySQL database name. Required. No default.
MYSQL_NAME=change-me
# MYSQL_USER: MySQL username. Required. No default.
MYSQL_USER=change-me
# MYSQL_PASSWORD: MySQL password. Required. No default.
MYSQL_PASSWORD=change-me
# MYSQL_ROOT_PASSWORD: MySQL root password used by the local container. Required. No default.
MYSQL_ROOT_PASSWORD=change-me
# REDIS_CACHE_URL: Redis URL for cache, locks, rate limiting, short-term state, and idempotency. Required. Must use db 0.
REDIS_CACHE_URL=redis://redis:6379/0
# CELERY_BROKER_URL: Redis URL for Celery broker and result backend. Required. Must use db 1.
CELERY_BROKER_URL=redis://redis:6379/1
# MINIO_ENDPOINT: MinIO endpoint used by the backend. Required. No default.
MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY: MinIO access key. Required. No default.
MINIO_ACCESS_KEY=change-me
# MINIO_SECRET_KEY: MinIO secret key. Required. No default.
MINIO_SECRET_KEY=change-me
# MINIO_SECURE: Use HTTPS for MinIO. Optional. Default: false.
MINIO_SECURE=false
# MINIO_GENERAL_BUCKET: General file bucket. Required. No default.
MINIO_GENERAL_BUCKET=change-me-general
# MINIO_ARCHIVE_BUCKET: Experiment result and archive bucket. Required. No default.
MINIO_ARCHIVE_BUCKET=change-me-archive
# MINIO_SNAPSHOT_BUCKET: Runtime snapshot bucket. Required. No default.
MINIO_SNAPSHOT_BUCKET=change-me-snapshot
# MINIO_EXPORT_BUCKET: Audit export bucket. Required. No default.
MINIO_EXPORT_BUCKET=change-me-export

# Trusted portal configuration
PORTAL_TRUST_PROXY_ENABLED=false
PORTAL_TRUSTED_PROXY_IPS=127.0.0.1,::1
PORTAL_TRUSTED_PROXY_HOSTS=
PORTAL_HOST_MAP=localhost=USER,127.0.0.1=USER,user.example.edu=USER,teacher.example.edu=TEACHING,admin.example.edu=PLATFORM
OPENAPI_TITLE=Agent Virtual Lab API
