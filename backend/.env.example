APP_ENV=local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

MYSQL_DATABASE=your_database_name
MYSQL_USER=your_database_user
MYSQL_PASSWORD=replace-with-your-local-password
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

PORTAL_TRUST_PROXY_ENABLED=false
PORTAL_TRUSTED_PROXY_IPS=127.0.0.1
PORTAL_REQUIRE_HOST_MATCH=true
PORTAL_HOST_MAP=localhost=STUDENT,127.0.0.1=STUDENT,student.example.edu=STUDENT,teacher.example.edu=TEACHER,admin.example.edu=ADMIN
SESSION_PORTAL_BINDING_ENABLED=true

OPENAPI_TITLE=Agent Virtual Lab API
OPENAPI_VERSION=2.0.0
OPENAPI_SERVE_PUBLIC=false
OPENAPI_SCHEMA_PATH=artifacts/openapi/openapi-v2.yaml
